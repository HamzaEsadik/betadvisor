{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:betadvisor:schema:health:1",
  "title": "BetAdvisor health.json",
  "description": "Heartbeat written by the scheduled GitHub Actions jobs: the last successful run of each job.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "jobs"],
  "properties": {
    "schema_version": { "const": 1 },
    "updated_at": { "$ref": "#/$defs/utcDateTime" },
    "jobs": {
      "type": "object",
      "propertyNames": { "enum": ["daily", "closing", "results"] },
      "additionalProperties": { "$ref": "#/$defs/job" }
    }
  },
  "$defs": {
    "utcDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["last_success_at", "run_url"],
      "properties": {
        "last_success_at": { "$ref": "#/$defs/utcDateTime" },
        "run_url": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^https://" }] }
      }
    }
  }
}
