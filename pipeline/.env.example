# Copy to pipeline/.env (git-ignored) and fill in. Real environment variables take precedence.
# https://www.football-data.org/client/register (free tier: PL, PD, BL1, FL1)
FOOTBALL_DATA_ORG_TOKEN=
# https://the-odds-api.com (free tier: 500 credits/month; each run uses 4)
ODDS_API_KEY=
# Optional: https://dashboard.api-football.com (free tier). Empty = injuries "unknown".
API_FOOTBALL_KEY=
